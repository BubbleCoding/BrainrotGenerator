# Copy this to .env and fill in your OpenAI key
OPENAI_API_KEY=sk-...
# Optional: change default image size/style
IMAGE_SIZE=1024x1024
IMAGE_QUALITY=standard
IMAGE_STYLE=vivid

# These are required; otherwise the app will refuse to deploy/start
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=...
SECRET_KEY=...